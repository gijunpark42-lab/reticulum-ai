# Copy this file to local-ask/.env and fill it in. .env is git-ignored.
# Keep each value on its own line with nothing after it (no inline comments).

# REQUIRED. A long random string; the Vercel route must send the SAME value in
# its x-ask-secret header (set it as ASK_SHARED_SECRET on Vercel too). Make one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ASK_SHARED_SECRET=replace-me-with-a-long-random-string

# Which Claude the CLI runs. "opus" is the alias for the latest Opus; a full
# model name works too. Effort: low | medium | high | xhigh | max.
ASK_MODEL=opus
ASK_EFFORT=max

# Safety caps: hard spend cap per question (claude --max-budget-usd) and the
# time after which a claude process is killed.
ASK_MAX_BUDGET_USD=1
ASK_TIMEOUT_MS=200000

# Where the CLI is. Leave unset if `claude --version` works in a terminal.
# ASK_CLAUDE_BIN=C:\Users\you\.local\bin\claude.exe

# Network. Keep 127.0.0.1: the tunnel (cloudflared / tailscale) connects locally.
HOST=127.0.0.1
PORT=8787

# Used only by smoke.mjs when testing through the tunnel.
# LOCAL_ASK_URL=https://xxxx.trycloudflare.com
